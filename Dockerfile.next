# Stage 1: Build the MkDocs static site for API Manager next only.
# en/mkdocs.yml's nav lists every APIM version; trim-mkdocs-version.py strips
# it down to just this one before `mkdocs build` runs, and
# Dockerfile.next.dockerignore keeps every other version's docs out of the
# build context so they never reach this image.
FROM python:3.12 AS builder

WORKDIR /app

COPY en/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir "setuptools<80"

COPY en/ .
COPY trim-mkdocs-version.py .
RUN python3 trim-mkdocs-version.py mkdocs.yml next

RUN mkdocs build

# Stage 2: Serve with Nginx
FROM nginx:1.26-alpine

COPY --from=builder --chown=10014:nginx /app/site /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

RUN apk upgrade --no-cache libcrypto3 libssl3

RUN adduser -u 10014 -D -H -G nginx appuser \
    && chown -R 10014:nginx /var/log/nginx \
    && chown -R 10014:nginx /var/cache/nginx \
    && chown -R 10014:nginx /etc/nginx/conf.d \
    && sed -i 's|/var/run/nginx.pid|/tmp/nginx.pid|g' /etc/nginx/nginx.conf

USER 10014

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
